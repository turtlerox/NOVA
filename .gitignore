# ═══════════════════════════════════════════════
# NOVA — .gitignore
# ═══════════════════════════════════════════════

# ── Entornos ─────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Node.js ──────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Frontend Build ───────────────────────────
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/

# ── Docker ───────────────────────────────────
docker-compose.override.yml

# ── Base de Datos ────────────────────────────
database/backups/*.sql
database/backups/*.dump
postgres_data/

# ── IDEs ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing ──────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
coverage/

# ── Logs ─────────────────────────────────────
*.log
logs/
