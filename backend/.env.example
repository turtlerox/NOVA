# ═══════════════════════════════════════════════
# NOVA Backend — Variables de Entorno
# ═══════════════════════════════════════════════

# ── Aplicación ───────────────────────────────
APP_NAME=NOVA
DEBUG=true
LOG_LEVEL=debug

# ── Base de Datos ────────────────────────────
DATABASE_URL=postgresql://nova_user:nova_secret_password@db:5432/nova_db

# ── Seguridad ────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
